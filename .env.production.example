# Copy to .env.production on the server and fill every value. Never commit it.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Public origin ------------------------------------------------------------
SMARTOPS_DOMAIN=ops.example.com
# An email address for Let's Encrypt, or "internal" for a self-signed local CA.
SMARTOPS_TLS=admin@example.com

# --- Secrets (the API refuses to start in production with defaults/short values)
SMARTOPS_JWT_SECRET=
SMARTOPS_INTERNAL_TOKEN=
POSTGRES_PASSWORD=
SMARTOPS_DATABASE_URL=postgresql+psycopg://smartops:${POSTGRES_PASSWORD}@postgres:5432/smartops
MINIO_ROOT_USER=smartops-prod
MINIO_ROOT_PASSWORD=

# Accounts allowed to create client workspaces (comma-separated).
SMARTOPS_PLATFORM_ADMIN_EMAILS=ops@example.com

# --- First deploy only: create demo workspaces and accounts, then set false.
SMARTOPS_SEED_DEMO_DATA=false

# --- Models ---------------------------------------------------------------------
# GPU server running vLLM / LM Studio / Ollama's OpenAI API:
#   SMARTOPS_MODEL_PROVIDER=openai-compatible
#   SMARTOPS_MODEL_BASE_URL=http://gpu-host:8000/v1
#   SMARTOPS_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Ollama in Docker on the same Linux GPU host: add --profile docker-ollama and
#   SMARTOPS_OLLAMA_HOST=http://ollama:11434
SMARTOPS_MODEL_PROVIDER=ollama
SMARTOPS_OLLAMA_HOST=http://ollama:11434
SMARTOPS_VISION_MODEL=qwen2.5vl:7b
SMARTOPS_TEXT_MODEL=llama3.2:3b
SMARTOPS_MODEL_API_KEY=
SMARTOPS_STREAM_ENRICHMENT=true
# Detector: ultralytics-cpu (default), ultralytics-cuda (GPU host; build the
# detector with TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121 and give
# it the GPU), or remote with SMARTOPS_DETECTOR_REMOTE_URL=https://gpu-box:8200
SMARTOPS_DETECTOR_BACKEND=ultralytics-cpu
