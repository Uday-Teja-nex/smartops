# ---------------------------------------------------------------------------
# SmartOps local environment. Copy to .env and adjust as needed.
# Every value below matches the docker-compose default, so an empty .env
# (or none at all) still produces a working local stack.
# ---------------------------------------------------------------------------

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Core infrastructure ----------------------------------------------------
SMARTOPS_ENVIRONMENT=development
SMARTOPS_DATABASE_URL=postgresql+psycopg://smartops:smartops@postgres:5432/smartops
SMARTOPS_REDIS_URL=redis://redis:6379/0
SMARTOPS_CORS_ORIGINS=http://localhost:3000
POSTGRES_DB=smartops
POSTGRES_USER=smartops
POSTGRES_PASSWORD=smartops

# --- Auth (change both for any non-local deployment) ------------------------
SMARTOPS_JWT_SECRET=smartops-dev-secret-change-me
# Access tokens are short-lived; an HttpOnly refresh cookie (rotated on use,
# revoked on logout) keeps the browser signed in.
SMARTOPS_JWT_TTL_MINUTES=15
SMARTOPS_REFRESH_TTL_HOURS=12
# Must be true behind HTTPS; production startup refuses false.
SMARTOPS_REFRESH_COOKIE_SECURE=false
SMARTOPS_INTERNAL_TOKEN=smartops-internal-dev-token
SMARTOPS_SEED_DEMO_DATA=true

# --- Models / AI ------------------------------------------------------------
SMARTOPS_MODEL_PROVIDER=ollama
# Native host by default. With --profile docker-ollama, use http://ollama:11434.
SMARTOPS_OLLAMA_HOST=http://host.docker.internal:11434
SMARTOPS_TEXT_MODEL=llama3.2:3b
SMARTOPS_VISION_MODEL=qwen2.5vl:3b
SMARTOPS_MODEL_TIMEOUT_SECONDS=30
# Hosted provider setup and explicit model IDs: docs/FREE_API_SETUP.md
SMARTOPS_MODEL_API_KEY=
SMARTOPS_MODEL_BASE_URL=
SMARTOPS_OPENROUTER_FREE_ONLY=true
SMARTOPS_OPENROUTER_DATA_COLLECTION=deny
# Asynchronous single-image reviews; 40 automatic requests/day across cameras.
SMARTOPS_STREAM_ENRICHMENT=false
SMARTOPS_RTSP_DECODE_THREADS=1
SMARTOPS_REVIEW_CONFIDENCE_THRESHOLD=0.6
# Ollama memory hygiene for laptop Docker VMs
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=2m

# --- Detector (YOLO) --------------------------------------------------------
SMARTOPS_DETECTOR_BACKEND=ultralytics-cpu
# Optional hosted CV experiments; keep local detection for continuous streams.
SMARTOPS_HF_TOKEN=
SMARTOPS_HF_MODEL=facebook/detr-resnet-50
SMARTOPS_HF_TIMEOUT_SECONDS=10
SMARTOPS_DETECTOR_CPU_THREADS=2
SMARTOPS_DETECTOR_IMAGE_SIZE=640
SMARTOPS_YOLO_MODEL=yolov8n.pt
SMARTOPS_CROWD_PERSON_THRESHOLD=4
SMARTOPS_MIN_DETECTION_CONFIDENCE=0.35

# --- Ingestion --------------------------------------------------------------
SMARTOPS_SCAN_INTERVAL_SECONDS=30
SMARTOPS_AUTODISCOVER_MP4=true
SMARTOPS_DEFAULT_BUILDING_ID=bldg-north-01
SMARTOPS_DEFAULT_FLOOR=L1
SMARTOPS_DEFAULT_ZONE=Lobby Atrium
SMARTOPS_MAX_WINDOWS_PER_SOURCE=12

# --- Worker -----------------------------------------------------------------
SMARTOPS_SAMPLE_FRAME_COUNT=3
SMARTOPS_MAX_FRAME_WIDTH=640
SMARTOPS_JOB_MAX_ATTEMPTS=3

# --- Evidence storage (MinIO / S3-compatible) --------------------------------
MINIO_ROOT_USER=smartops
MINIO_ROOT_PASSWORD=smartopsminio
SMARTOPS_MINIO_ENDPOINT=http://minio:9000
SMARTOPS_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
SMARTOPS_MINIO_BUCKET=smartops-evidence
SMARTOPS_EVIDENCE_STORAGE_ENABLED=true
SMARTOPS_EVIDENCE_ENABLED=true
SMARTOPS_EVIDENCE_URL_TTL_SECONDS=600
SMARTOPS_EVIDENCE_CLIP_MAX_SECONDS=20

# Continuous stream engineering profile (demo-streams)
SMARTOPS_LOOP_FILE=/media/first test video.mp4
# Empty means discover enabled RTSP sources; optional comma-separated allowlist.
SMARTOPS_STREAM_SOURCE_IDS=
SMARTOPS_MAX_STREAMS=3
SMARTOPS_STREAM_FPS=3
SMARTOPS_MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889
SMARTOPS_MEDIAMTX_RTSP_HOST=mediamtx
