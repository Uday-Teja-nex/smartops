FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-processor.txt .
RUN pip install --no-cache-dir -r requirements-processor.txt
COPY app ./app
RUN mkdir /data && chown nobody:nogroup /data
ENV MPLCONFIGDIR=/tmp/matplotlib
USER nobody
CMD ["python", "-m", "app.supervisor"]
